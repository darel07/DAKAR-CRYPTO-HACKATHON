# Copier en .env pour le développement local (jamais versionné).
# Toutes les variables sont facultatives : sans rien, l'API démarre en mode règle (sans IA).

# Écoute
HOST=0.0.0.0
PORT=8080

# Base des liens courts de passeport (sans barre finale)
PUBLIC_URL=http://localhost:8080

# Origines autorisées, séparées par des virgules. Jamais « * ».
CORS_ORIGINS=http://localhost:5173

# Fichier SQLite (le dossier doit exister et être accessible en écriture)
DATABASE_PATH=./caisse.sqlite

# Dossier du front compilé (servi en statique s'il existe)
FRONT_DIST=../app/dist

# ---------- IA (facultative : sans configuration, règles locales) ----------
# Ne jamais coller une clé dans un ticket, un commit ou un message.
#
# Option 1 : Claude (payant)
#   IA_FOURNISSEUR=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   IA_MODELE=claude-opus-5-5
#
# Option 2 : fournisseur compatible OpenAI, offres gratuites sans carte bancaire.
#   Groq   : clé sur https://console.groq.com/keys
#     IA_URL_BASE=https://api.groq.com/openai/v1
#   Gemini : clé sur https://aistudio.google.com/apikey
#     IA_URL_BASE=https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama (local, aucune donnée ne quitte la machine ; IA_CLE : valeur quelconque)
#     IA_URL_BASE=http://localhost:11434/v1   (depuis Docker : http://host.docker.internal:11434/v1,
#     avec OLLAMA_HOST=0.0.0.0 côté Ollama)
#     IA_MODELE=qwen2.5:1.5b-instruct          (mesuré : 8/9, 2 à 3 s sur processeur)
#   Le nom exact du modèle dépend du fournisseur : `npm run essai-ia` liste ceux disponibles.
IA_FOURNISSEUR=anthropic
ANTHROPIC_API_KEY=
IA_URL_BASE=
IA_CLE=
IA_MODELE=

# true derrière un proxy (Railway, Render, nginx) pour que la limite de débit voie la vraie IP
TRUST_PROXY=false

# fatal | error | warn | info | debug
LOG_LEVEL=info

# true : crée ou rafraîchit le passeport de démonstration « demo000000 » au démarrage
SEED_DEMO=false
