# Copier en .env pour le développement local (jamais versionné).
# Toutes les variables sont facultatives : sans rien, l'API démarre en mode règle (sans IA).

# Écoute
HOST=0.0.0.0
PORT=8080

# Base des liens courts de passeport (sans barre finale)
PUBLIC_URL=http://localhost:8080

# Origines autorisées, séparées par des virgules. Jamais « * ».
CORS_ORIGINS=http://localhost:5173

# Fichier SQLite (le dossier doit exister et être accessible en écriture)
DATABASE_PATH=./caisse.sqlite

# Dossier du front compilé (servi en statique s'il existe)
FRONT_DIST=../app/dist

# Clé de l'API Claude. Absente : l'analyse et le résumé utilisent les règles locales.
# Ne jamais la coller dans un ticket, un commit ou un message.
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour l'analyse et le résumé
IA_MODELE=claude-opus-5-5

# true derrière un proxy (Railway, Render, nginx) pour que la limite de débit voie la vraie IP
TRUST_PROXY=false

# fatal | error | warn | info | debug
LOG_LEVEL=info

# true : crée ou rafraîchit le passeport de démonstration « demo000000 » au démarrage
SEED_DEMO=false
